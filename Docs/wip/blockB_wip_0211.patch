diff --git a/game/scripts/actors/puppet_actor.gd b/game/scripts/actors/puppet_actor.gd
index 71d9735e..fc80dc77 100644
--- a/game/scripts/actors/puppet_actor.gd
+++ b/game/scripts/actors/puppet_actor.gd
@@ -265,6 +265,10 @@ func _skin(verts: PackedVector2Array) -> void:
 	var hy: Array = reg.get("head_y", [600, 520])
 	var ey: Array = reg.get("ear_y", [330, 265])
 	var split_x := float(reg.get("ear_split_x", 470))
+	var tail_poly := PackedVector2Array()
+	for q in reg.get("tail_poly", []):
+		tail_poly.append(Vector2(float(q[0]), float(q[1])))
+	var tail_feather := float(reg.get("tail_feather", 30.0))
 	var tails: Array = []
 	for b in spec.get("bones", []):
 		if String(b["name"]).begins_with("tail"):
@@ -278,6 +282,17 @@ func _skin(verts: PackedVector2Array) -> void:
 		var p: Vector2 = verts[i] / tex_scale + feet   # back to source px
 		# the tail region: right of tail_x (the standing Tikhon) or, with tail_x reversed, left of it (the loaf)
 		var t_tail := smoothstep(float(tx[0]), float(tx[1]), p.x) if float(tx[0]) <= float(tx[1]) else 1.0 - smoothstep(float(tx[1]), float(tx[0]), p.x)
+		# Director 02.11 вечер, № 2 («хвост затмевает модель… хвост и ухо как будто склеены»): in the loaf the tail wraps
+		# round the body and the left ear stands right over it — a vertical line cannot part them. `tail_poly` (source
+		# px) outlines the tail itself; outside it the weight fades over `tail_feather` px
+		if tail_poly.size() >= 3:
+			if Geometry2D.is_point_in_polygon(p, tail_poly):
+				t_tail = 1.0
+			else:
+				var dmin := INF
+				for k in tail_poly.size():
+					dmin = minf(dmin, Geometry2D.get_closest_point_to_segment(p, tail_poly[k], tail_poly[(k + 1) % tail_poly.size()]).distance_to(p))
+				t_tail = 1.0 - smoothstep(0.0, tail_feather, dmin)
 		var t_head := smoothstep(float(hy[0]), float(hy[1]), p.y) * (1.0 - t_tail)
 		var t_ear := smoothstep(float(ey[0]), float(ey[1]), p.y) * t_head
 		t_head -= t_ear
diff --git a/game/scripts/rooms/state_layer.gd b/game/scripts/rooms/state_layer.gd
index 1c2954e7..0698a670 100644
--- a/game/scripts/rooms/state_layer.gd
+++ b/game/scripts/rooms/state_layer.gd
@@ -88,11 +88,19 @@ var _life_cfg: Dictionary = {}
 
 func _setup_life() -> void:
 	var c = data.get("compose", {})
-	if not (c is Dictionary) or String(c.get("char", "")) == "" or not c.has("feet"):
-		return
 	var lf = data.get("life", true)
 	if lf is bool and not lf:
 		return
+	# Director 02.11 вечер, № 25 («Тихон на последнем кадре двигался и говорил — почему убрали?»): a figure pasted from
+	# a picture (compose src, not a sheet) — Tikhon at the dinner — breathes and moves his head with his words when the
+	# layer's `life` names him: {"char", "feet", "height"} in canvas px (the sheet figures take these from compose)
+	if c is Dictionary and String(c.get("char", "")) == "" and lf is Dictionary and String(lf.get("char", "")) != "":
+		c = (c as Dictionary).duplicate()
+		for k in ["char", "feet", "height"]:
+			if lf.has(k):
+				c[k] = lf[k]
+	if not (c is Dictionary) or String(c.get("char", "")) == "" or not c.has("feet"):
+		return
 	var img := get_node_or_null("Image") as Sprite2D
 	if img == null:
 		return
