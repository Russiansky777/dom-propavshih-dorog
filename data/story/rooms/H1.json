  "flags": {
    "h1_shutter_open": "Ставня в жилой комнате открыта",
    "h1_scarf_removed": "Мокрая дорожная вещь убрана с лежанки",
    "v01_photo_table": "Семейная фотография поставлена на стол (V01)",
    "v01_photo_shelf": "Семейная фотография поставлена на полку (V01)",
    "v01_cup_blue": "Выбрана синяя чашка (V01)",
    "v01_cup_white": "Выбрана белая чашка (V01)"
