        {
          "any": ["v01_photo_table", "v01_photo_shelf"]
        }
      ],
      "complete_text": "@H1.v01.done"
    },
    "Q04": {
      "complete_when": [
        {
          "any": ["q04_corner_stove", "q04_shelf_table"]
        }
      ]
    }
