#!/usr/bin/env bash
# 14.11: a push to main without «[skip ci]» in a commit's subject starts workflows by itself — build-and-publish (a new
# exe over the one just handed to the Director) and, when Docs/ACCEPTANCE_*.md changed, the paid ai-story-logic. That
# happened with commit 2d30c8d7 (both runs were cancelled before they did anything). This hook refuses such a push.
#   on:   git config core.hooksPath tools/hooks        (once per clone)
#   a push that is meant to start the workflows:  PUSH_RUNS_CI=1 git push …
# git gives the pushed refs on stdin: <local ref> <local sha> <remote ref> <remote sha>.
set -uo pipefail
[[ "${PUSH_RUNS_CI:-}" == "1" ]] && exit 0
zero="0000000000000000000000000000000000000000"
bad=0
while read -r _lref lsha rref rsha; do
  [[ "$rref" == "refs/heads/main" && "$lsha" != "$zero" ]] || continue
  range="$lsha"; [[ "$rsha" != "$zero" ]] && range="$rsha..$lsha"
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    case "$line" in
      *"[skip ci]"*) ;;
      *) echo "pre-push: no «[skip ci]» in the subject — $line" >&2; bad=1 ;;
    esac
  done < <(git log --format='%h %s' "$range" 2>/dev/null)
done
if [[ "$bad" == 1 ]]; then
  echo "pre-push: the push to main is refused: it would start build-and-publish (and paid checks on Docs/ACCEPTANCE_*.md)." >&2
  echo "pre-push: amend the subject, or — if the workflows are meant to run — PUSH_RUNS_CI=1 git push …" >&2
  exit 1
fi
exit 0
